{
  "name": "carefind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "preview": "vite preview",
    "lint": "eslint src api --ext .js,.jsx --resolve-plugins-relative-to .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:concurrency": "vitest run --config vitest.payments.config.js src/test/payments/settlementConcurrency.pg.test.js",
    "test:finance": "vitest run api src/test/payments --exclude \"**/*.pg.test.js\"",
    "test:finance:pg": "vitest run --no-file-parallelism pg.test",
    "test:mutation": "node src/test/payments/mutation/run.mjs",
    "bench:finance": "node src/test/payments/bench/scale.bench.mjs"
  },
  "dependencies": {
    "@care-ecosystem/shared-email": "file:../../packages/shared-email",
    "@care-ecosystem/shared-marketplace": "file:../../packages/shared-marketplace",
    "@care-ecosystem/shared-payments": "file:../../packages/shared-payments",
    "@sentry/react": "^10.73.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.0",
    "read-excel-file": "^9.3.12",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^24.1.0",
    "pg": "^8.23.1",
    "resend": "^2.0.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
