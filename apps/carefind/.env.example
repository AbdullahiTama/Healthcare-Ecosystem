# CareFind app environment variables
# Copy to .env and fill in your real values.
# Get SUPABASE_URL / SUPABASE_ANON_KEY from Supabase Dashboard > Project Settings > API

# Public (publishable) Supabase project credentials — safe to expose in the
# client bundle. These back every CareFind read/write via src/config/supabaseClient.js.
VITE_SUPABASE_URL=https://szdybxmgmhndoytqanfb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xEs5f4L6qSxqXikPZM06SQ_TKy4UNFz

# Sentry error tracking — get DSN from https://sentry.io
# Leave empty to disable Sentry (init is a no-op when DSN is missing)
VITE_SENTRY_DSN=

# Server-side only — used by API routes (payment webhooks, etc.)
# Do NOT prefix these with VITE_ — they must never reach the client bundle.
SUPABASE_URL=https://szdybxmgmhndoytqanfb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_REPLACE_WITH_YOUR_SERVICE_ROLE_KEY
# Paystack SECRET key — must start with sk_live_ (production) or sk_test_
# (test mode). Get it from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_REAL_PAYSTACK_SECRET_KEY
# IMPORTANT: Do NOT use pk_live_ / pk_test_ publishable key here - server validates sk_ prefix
# and will throw Invalid Paystack key before contacting Paystack.

# Resend email API — get key from https://resend.com/api-keys
# Leave RESEND_API_KEY empty to disable email (graceful no-op).
# Preferred sender: CareFind <notifications@carefind.app> (domain must be
# verified in Resend first — see docs/architecture/Email-Production-Setup.md).
RESEND_API_KEY=
EMAIL_FROM=CareFind <notifications@carefind.app>
EMAIL_REPLY_TO=support@carefind.app
# Legacy fallbacks still accepted by the code
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# App URLs used in email links
CAREFIND_APP_URL=https://carefind.app
CAREHUB_APP_URL=https://carehub.ng
APP_URL=https://carefind.app
SITE_URL=https://carefind.app

# Admin notification recipients
CAREFIND_ADMIN_EMAIL=admin@carefind.app
CAREHUB_ADMIN_EMAIL=admin@carehub.ng
ADMIN_EMAIL=admin@carefind.app

# Cron secret for email outbox worker authentication
CRON_SECRET=change-me-to-a-secure-random-string
# Wallet lifecycle: MAX_PRICE_COINS=12 (NAIRA_PER_COIN=200, max 2400) enforced server-side in charge-subscription.js
