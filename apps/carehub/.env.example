# CareHub app environment variables
# Copy to .env and fill in your real values.
# Get SUPABASE_URL / SUPABASE_ANON_KEY from Supabase Dashboard > Project Settings > API

# Public (publishable) Supabase project credentials — safe to expose in the
# client bundle. These back every CareHub read/write via src/config/supabase.js.
VITE_SUPABASE_URL=https://szdybxmgmhndoytqanfb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xEs5f4L6qSxqXikPZM06SQ_TKy4UNFz

# Sentry error tracking — get DSN from https://sentry.io
# Leave empty to disable Sentry (init is a no-op when DSN is missing)
VITE_SENTRY_DSN=

# Server-side only — used by API routes (payment webhooks, etc.)
SUPABASE_URL=https://szdybxmgmhndoytqanfb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_REPLACE_WITH_YOUR_SERVICE_ROLE_KEY
# Paystack SECRET key — must start with sk_live_ (production) or sk_test_
# (test mode). Get it from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_REAL_PAYSTACK_SECRET_KEY
# IMPORTANT: Do NOT use pk_live_ / pk_test_ publishable key here - server validates sk_ prefix
# and will throw Invalid Paystack key before contacting Paystack.

# Email (Resend) — server-side only. Get from https://resend.com/api-keys
# Preferred production senders (domains must be verified in Resend first — see
# docs/architecture/Email-Production-Setup.md):
#   CareHub  <notifications@carehub.ng>   CareFind <notifications@carefind.app>
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY
EMAIL_FROM=CareHub <notifications@carehub.ng>
EMAIL_REPLY_TO=support@carehub.ng
# Legacy fallbacks still accepted by the code (RESEND_FROM_EMAIL / RESEND_REPLY_TO)
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# App URLs used in email links
CAREHUB_APP_URL=https://carehub.ng
CAREFIND_APP_URL=https://carefind.app
APP_URL=https://carehub.ng
# SITE_URL is not read by any code today (APP_URL is); kept for compatibility.
SITE_URL=https://carehub.ng

# Admin notification recipients for account/approval alerts
CAREHUB_ADMIN_EMAIL=admin@carehub.ng
CAREFIND_ADMIN_EMAIL=admin@carefind.app
ADMIN_EMAIL=admin@carehub.ng

# Cron secret for email outbox worker authentication
CRON_SECRET=change-me-to-a-secure-random-string

# Resend webhook signing secret (starts with whsec_) — Resend > Webhooks > your endpoint > Signing secret.
# The endpoint is /api/webhooks/resend. Without this the webhook answers 500 and no bounce or complaint is recorded.
RESEND_WEBHOOK_SECRET=

# ── Optional tuning. Defaults are shown; leave these unset unless you need to change them. ──
# Minimum time /api/auth-email takes to answer, so a real account is not slower than an unknown one (ms).
# AUTH_EMAIL_MIN_RESPONSE_MS=1500
# Outbox worker: rows per batch (1-100), batches per run (1-20), and how long it keeps claiming rows before it stops
# and leaves the rest for the next run (ms). Keep the budget below the function's max duration.
# EMAIL_OUTBOX_BATCH_SIZE=20
# EMAIL_OUTBOX_MAX_BATCHES=4
# EMAIL_OUTBOX_TIME_BUDGET_MS=8000
# How long one send to Resend may take before it is abandoned and retried (1000-60000 ms).
# EMAIL_SEND_TIMEOUT_MS=15000
# How many days an address that bounced is left alone before it is tried again (1-3650). An address that reported an
# email as spam is never mailed again, whatever this is set to.
# EMAIL_BOUNCE_SUPPRESS_DAYS=30
# Optional URL of a Google Places proxy for facility discovery. It is a VITE_ variable, so it is PUBLIC:
# put a URL here, never a key.
# VITE_GOOGLE_PLACES_PROXY=
