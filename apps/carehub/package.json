    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "cmdk": "^1.1.1",
    "command-score": "^0.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
